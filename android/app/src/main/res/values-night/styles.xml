<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts, before Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ground</item>
    </style>
    <!-- The window colour behind the Flutter UI once it is running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>
</resources>
